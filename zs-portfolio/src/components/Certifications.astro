---
// Certifications & Academic Milestones section
import { certifications } from '../data/profile';
---

<section
  id="certifications"
  class="section-padding bg-white dark:bg-surface-900 relative overflow-hidden"
  aria-label="Certifications and Academic Milestones"
>
  <div class="section-container relative z-10">
    <div class="text-center max-w-2xl mx-auto mb-16">
      <div class="section-label justify-center" data-reveal>Verification &amp; Learning</div>
      <h2 class="font-display text-4xl sm:text-5xl font-bold text-surface-900 dark:text-surface-50 mb-4 tracking-tight" data-reveal data-delay="100">
        Milestones &amp; Credentials
      </h2>
      <p class="text-surface-600 dark:text-surface-400 text-lg leading-relaxed" data-reveal data-delay="200">
        Honest, verified milestones. Academic progress and competitive problem-solving credentials are listed accurately without manufactured certificates.
      </p>
    </div>

    <div class="grid md:grid-cols-3 gap-6 max-w-5xl mx-auto">
      {certifications.map((item, i) => (
        <div
          class="card p-6 flex flex-col relative group"
          data-reveal
          data-delay={String(i * 100 + 150)}
        >
          <!-- Top badge line -->
          <div class="flex items-center justify-between gap-2 mb-4">
            <span class={`px-2.5 py-1 rounded text-xs font-mono font-medium border ${
              item.status === 'Active Student' ? 'bg-blue-500/10 text-blue-700 dark:text-blue-300 border-blue-500/20' :
              item.status === 'Active Practice' ? 'bg-amber-500/10 text-amber-700 dark:text-amber-300 border-amber-500/20' :
              'bg-teal-500/10 text-teal-700 dark:text-teal-300 border-teal-500/20'
            }`}>
              {item.status}
            </span>
            <span class="text-xs font-mono text-surface-400">{item.date}</span>
          </div>

          <!-- Icon & Title -->
          <div class="flex items-start gap-3 mb-3">
            <div class="w-10 h-10 rounded-xl bg-accent-500/10 flex items-center justify-center shrink-0 mt-0.5 group-hover:scale-105 transition-transform">
              <svg class="w-5 h-5 text-accent-600 dark:text-accent-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
              </svg>
            </div>
            <div>
              <h3 class="font-display font-bold text-surface-900 dark:text-surface-50 text-base leading-snug">
                {item.title}
              </h3>
              <p class="text-xs text-accent-600 dark:text-accent-400 font-medium mt-0.5">
                {item.issuer}
              </p>
            </div>
          </div>

          <!-- Description -->
          <p class="text-xs sm:text-sm text-surface-600 dark:text-surface-400 leading-relaxed flex-1 mb-4">
            {item.description}
          </p>

          <!-- Credential status footer -->
          <div class="pt-3 border-t border-surface-100 dark:border-surface-800 text-xs text-surface-500 dark:text-surface-400 flex items-center justify-between">
            <span class="font-mono text-2xs uppercase tracking-wider text-surface-400">Credential</span>
            <span class="font-medium text-surface-700 dark:text-surface-300">{item.credential}</span>
          </div>
        </div>
      ))}
    </div>

    <!-- Verified Authenticity Callout -->
    <div class="mt-12 max-w-2xl mx-auto p-4 rounded-xl bg-surface-50 dark:bg-surface-800/60 border border-surface-200/80 dark:border-surface-700/80 text-center" data-reveal data-delay="300">
      <div class="flex items-center justify-center gap-2 text-xs font-mono text-surface-500 dark:text-surface-400">
        <svg class="w-4 h-4 text-emerald-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
        </svg>
        <span>Zero manufactured certificates. Formal cloud and DevOps credentials will be added as verified milestones are achieved.</span>
      </div>
    </div>
  </div>
</section>
