---
// Contact section with working contact pipeline, clipboard utility, and verified links
---

<section
  id="contact"
  class="section-padding relative overflow-hidden bg-white dark:bg-surface-900"
  aria-label="Contact Information and Inquiries"
>
  <!-- Background atmosphere -->
  <div class="absolute inset-0 dot-pattern opacity-30 dark:opacity-20" aria-hidden="true"></div>
  <div class="absolute bottom-0 right-0 w-96 h-96 bg-accent-500/5 blur-3xl pointer-events-none" aria-hidden="true"></div>

  <div class="section-container relative z-10">
    <div class="max-w-3xl mx-auto text-center mb-16">
      <div class="section-label justify-center" data-reveal>Get in Touch</div>
      <h2 class="font-display text-4xl sm:text-5xl font-bold text-surface-900 dark:text-surface-50 mb-4 tracking-tight" data-reveal data-delay="100">
        Let's Connect &amp; Collaborate
      </h2>
      <p class="text-surface-600 dark:text-surface-400 text-lg leading-relaxed" data-reveal data-delay="200">
        Whether you're looking for a dedicated software engineering intern, want to collaborate on systems or DevOps projects, or need client development via Zentorix — my inbox is always open.
      </p>
    </div>

    <div class="grid lg:grid-cols-12 gap-8 items-start max-w-5xl mx-auto">

      <!-- Left Column (5 cols): Direct Contacts & Socials -->
      <div class="lg:col-span-5 space-y-6" data-reveal data-delay="250">

        <!-- Direct Email Card with One-Click Copy -->
        <div class="card p-6">
          <div class="flex items-center gap-3 mb-4">
            <div class="w-10 h-10 rounded-xl bg-accent-500/10 flex items-center justify-center text-accent-600 dark:text-accent-400">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
            </div>
            <div>
              <h3 class="font-display font-bold text-surface-900 dark:text-surface-50 text-base">Direct Email</h3>
              <p class="text-xs text-surface-500 font-mono">Response within 24–48 hours</p>
            </div>
          </div>

          <div class="p-3 rounded-lg bg-surface-50 dark:bg-surface-800/80 border border-surface-200 dark:border-surface-700/80 mb-4 flex items-center justify-between gap-2">
            <span class="font-mono text-xs sm:text-sm text-surface-800 dark:text-surface-200 truncate select-all" id="email-text">
              zulqarnainsaeed2005@gmail.com
            </span>
            <button
              type="button"
              id="copy-email-btn"
              class="p-2 rounded-md hover:bg-surface-200 dark:hover:bg-surface-700 text-surface-500 hover:text-accent-600 transition-colors shrink-0 cursor-pointer"
              aria-label="Copy email address"
              title="Copy to clipboard"
            >
              <svg id="copy-icon" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <rect x="9" y="9" width="13" height="13" rx="2" ry="2" />
                <path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1" />
              </svg>
              <svg id="copied-icon" class="w-4 h-4 text-emerald-500 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
              </svg>
            </button>
          </div>

          <a
            href="mailto:zulqarnainsaeed2005@gmail.com"
            class="btn-primary w-full justify-center text-sm py-2.5"
          >
            Open Mail Client →
          </a>
        </div>

        <!-- Verified Profiles Box -->
        <div class="card p-6">
          <h3 class="font-display font-semibold text-surface-900 dark:text-surface-100 text-sm mb-4">
            Verified Profiles &amp; Networks
          </h3>
          <div class="space-y-2.5">
            <a
              href="https://github.com/zulqarnain-saeed"
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center justify-between p-2.5 rounded-lg border border-surface-200 dark:border-surface-800 hover:border-surface-400 dark:hover:border-surface-600 bg-surface-50/50 dark:bg-surface-800/40 text-surface-700 dark:text-surface-300 transition-all text-xs font-medium group"
            >
              <span class="flex items-center gap-2">
                <svg class="w-4 h-4 text-surface-600 dark:text-surface-400" fill="currentColor" viewBox="0 0 24 24">
                  <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd" />
                </svg>
                GitHub Profile
              </span>
              <span class="font-mono text-2xs text-surface-400 group-hover:text-accent-500">zulqarnain-saeed ↗</span>
            </a>

            <a
              href="https://www.linkedin.com/in/zulqarnain-saeed/"
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center justify-between p-2.5 rounded-lg border border-surface-200 dark:border-surface-800 hover:border-[#0A66C2] bg-surface-50/50 dark:bg-surface-800/40 text-surface-700 dark:text-surface-300 transition-all text-xs font-medium group"
            >
              <span class="flex items-center gap-2">
                <svg class="w-4 h-4 text-[#0A66C2]" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
                </svg>
                LinkedIn Network
              </span>
              <span class="font-mono text-2xs text-surface-400 group-hover:text-[#0A66C2]">in/zulqarnain-saeed ↗</span>
            </a>

            <a
              href="https://leetcode.com/u/zulqarnain-saeed/"
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center justify-between p-2.5 rounded-lg border border-surface-200 dark:border-surface-800 hover:border-[#FFA116] bg-surface-50/50 dark:bg-surface-800/40 text-surface-700 dark:text-surface-300 transition-all text-xs font-medium group"
            >
              <span class="flex items-center gap-2">
                <svg class="w-4 h-4 text-[#FFA116]" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M13.483 0a1.374 1.374 0 0 0-.961.438L7.116 6.226l-3.854 4.126a5.266 5.266 0 0 0-1.209 2.104 5.35 5.35 0 0 0-.125.513 5.527 5.527 0 0 0 .062 2.362 5.83 5.83 0 0 0 .349 1.017 5.938 5.938 0 0 0 1.271 1.818l4.277 4.193.039.038c2.248 2.165 5.852 2.133 8.063-.074l2.396-2.392c.54-.54.54-1.414.003-1.955a1.378 1.378 0 0 0-1.951-.003l-2.396 2.392a3.021 3.021 0 0 1-4.205.038l-.02-.019-4.276-4.193c-.652-.64-.972-1.469-.948-2.263a2.68 2.68 0 0 1 .066-.523 2.545 2.545 0 0 1 .619-1.164L9.13 8.114c1.058-1.134 3.204-1.27 4.43-.278l3.501 2.831c.593.48 1.461.387 1.94-.207a1.384 1.384 0 0 0-.207-1.943l-3.5-2.831c-.8-.647-1.766-1.045-2.774-1.202l2.015-2.158A1.384 1.384 0 0 0 13.483 0zm-2.866 12.815a1.38 1.38 0 0 0-1.38 1.382 1.38 1.38 0 0 0 1.38 1.382H20.79a1.38 1.38 0 0 0 1.38-1.382 1.38 1.38 0 0 0-1.38-1.382z"/>
                </svg>
                LeetCode Profile
              </span>
              <span class="font-mono text-2xs text-surface-400 group-hover:text-[#FFA116]">u/zulqarnain-saeed ↗</span>
            </a>

            <a
              href="https://www.hackerrank.com/profile/zulqarnain_saeed"
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center justify-between p-2.5 rounded-lg border border-surface-200 dark:border-surface-800 hover:border-[#00EA64] bg-surface-50/50 dark:bg-surface-800/40 text-surface-700 dark:text-surface-300 transition-all text-xs font-medium group"
            >
              <span class="flex items-center gap-2">
                <svg class="w-4 h-4 text-[#00EA64]" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M12 0c1.285 0 9.75 4.886 10.392 6 .645 1.115.645 11.885 0 13-.642 1.115-9.107 6-10.392 6-1.284 0-9.75-4.885-10.392-6C.963 17.885.963 7.115 1.608 6 2.25 4.886 10.715 0 12 0zm2.295 6.799c-.141 0-.258.115-.258.258v3.875H9.963V6.915c0-.143-.116-.258-.258-.258h-1.78c-.141 0-.258.115-.258.258v10.171c0 .141.117.258.258.258h1.78c.142 0 .258-.117.258-.258v-4.007h4.074v4.007c0 .141.116.258.258.258h1.78c.142 0 .258-.117.258-.258V6.915c0-.143-.116-.258-.258-.258l-1.78-.058z"/>
                </svg>
                HackerRank Profile
              </span>
              <span class="font-mono text-2xs text-surface-400 group-hover:text-[#00EA64]">zulqarnain_saeed ↗</span>
            </a>
          </div>
        </div>

      </div>

      <!-- Right Column (7 cols): Functional Contact Form with Netlify Forms Integration -->
      <div class="lg:col-span-7" data-reveal data-delay="300">
        <div class="card p-6 sm:p-8">
          <div class="mb-6">
            <h3 class="font-display font-bold text-xl text-surface-900 dark:text-surface-50 mb-1">
              Send a Direct Message
            </h3>
            <p class="text-xs sm:text-sm text-surface-500 dark:text-surface-400">
              Fill out the form below. Messages are delivered directly to my inbox with validation and anti-spam handling.
            </p>
          </div>

          <!-- Netlify Contact Form -->
          <form
            name="contact"
            id="contact-form"
            method="POST"
            data-netlify="true"
            netlify-honeypot="bot-field"
            class="space-y-4"
          >
            <!-- Netlify required hidden fields -->
            <input type="hidden" name="form-name" value="contact" />
            <p class="hidden">
              <label>Don’t fill this out if you're human: <input name="bot-field" /></label>
            </p>

            <div class="grid sm:grid-cols-2 gap-4">
              <div>
                <label for="contact-name" class="block text-xs font-mono font-medium text-surface-700 dark:text-surface-300 mb-1.5">
                  Your Name <span class="text-accent-500">*</span>
                </label>
                <input
                  type="text"
                  id="contact-name"
                  name="name"
                  required
                  placeholder="e.g. Alex Chen"
                  class="w-full px-3.5 py-2.5 rounded-lg border border-surface-200 dark:border-surface-700 bg-surface-50 dark:bg-surface-800 text-surface-900 dark:text-surface-100 text-sm focus:border-accent-500 focus:outline-none transition-colors"
                />
              </div>

              <div>
                <label for="contact-email" class="block text-xs font-mono font-medium text-surface-700 dark:text-surface-300 mb-1.5">
                  Email Address <span class="text-accent-500">*</span>
                </label>
                <input
                  type="email"
                  id="contact-email"
                  name="email"
                  required
                  placeholder="name@company.com"
                  class="w-full px-3.5 py-2.5 rounded-lg border border-surface-200 dark:border-surface-700 bg-surface-50 dark:bg-surface-800 text-surface-900 dark:text-surface-100 text-sm focus:border-accent-500 focus:outline-none transition-colors"
                />
              </div>
            </div>

            <div>
              <label for="contact-subject" class="block text-xs font-mono font-medium text-surface-700 dark:text-surface-300 mb-1.5">
                Subject
              </label>
              <input
                type="text"
                id="contact-subject"
                name="subject"
                placeholder="Software Internship / Project Inquiry"
                class="w-full px-3.5 py-2.5 rounded-lg border border-surface-200 dark:border-surface-700 bg-surface-50 dark:bg-surface-800 text-surface-900 dark:text-surface-100 text-sm focus:border-accent-500 focus:outline-none transition-colors"
              />
            </div>

            <div>
              <label for="contact-message" class="block text-xs font-mono font-medium text-surface-700 dark:text-surface-300 mb-1.5">
                Message <span class="text-accent-500">*</span>
              </label>
              <textarea
                id="contact-message"
                name="message"
                rows="4"
                required
                minlength="10"
                placeholder="Hello Zulqarnain, we'd like to discuss an opportunity..."
                class="w-full px-3.5 py-2.5 rounded-lg border border-surface-200 dark:border-surface-700 bg-surface-50 dark:bg-surface-800 text-surface-900 dark:text-surface-100 text-sm focus:border-accent-500 focus:outline-none transition-colors resize-y"
              ></textarea>
            </div>

            <div id="form-status" class="hidden text-xs rounded-lg p-3 font-medium"></div>

            <button
              type="submit"
              id="submit-btn"
              class="btn-primary w-full justify-center text-sm py-3 cursor-pointer"
            >
              <span id="btn-text">Send Message</span>
              <svg id="btn-spinner" class="w-4 h-4 animate-spin hidden" fill="none" viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
              </svg>
            </button>
          </form>
        </div>
      </div>

    </div>
  </div>
</section>

<!-- Contact Form Submission & Clipboard Scripts -->
<script>
  // One-click Copy Email
  const copyBtn = document.getElementById('copy-email-btn');
  const copyIcon = document.getElementById('copy-icon');
  const copiedIcon = document.getElementById('copied-icon');
  const emailStr = 'zulqarnainsaeed2005@gmail.com';

  if (copyBtn) {
    copyBtn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(emailStr);
        copyIcon?.classList.add('hidden');
        copiedIcon?.classList.remove('hidden');
        copyBtn.setAttribute('title', 'Copied to clipboard!');

        setTimeout(() => {
          copyIcon?.classList.remove('hidden');
          copiedIcon?.classList.add('hidden');
          copyBtn.setAttribute('title', 'Copy to clipboard');
        }, 2500);
      } catch (err) {
        // Fallback for permissions
        const textarea = document.createElement('textarea');
        textarea.value = emailStr;
        document.body.appendChild(textarea);
        textarea.select();
        document.execCommand('copy');
        document.body.removeChild(textarea);
      }
    });
  }

  // Netlify Form Submission Handler with Direct Mailto Fallback
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const submitBtn = document.getElementById('submit-btn');
  const btnText = document.getElementById('btn-text');
  const btnSpinner = document.getElementById('btn-spinner');
  const formStatus = document.getElementById('form-status');

  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      const nameInput = document.getElementById('contact-name') as HTMLInputElement;
      const emailInput = document.getElementById('contact-email') as HTMLInputElement;
      const subjectInput = document.getElementById('contact-subject') as HTMLInputElement;
      const messageInput = document.getElementById('contact-message') as HTMLTextAreaElement;

      // Basic client-side validation
      if (!nameInput.value.trim() || !emailInput.value.trim() || !messageInput.value.trim()) {
        showStatus('Please complete all required fields.', 'error');
        return;
      }

      setLoading(true);

      const formData = new FormData(form);

      try {
        const response = await fetch('/', {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body: new URLSearchParams(formData as any).toString(),
        });

        if (response.ok) {
          showStatus('Thank you! Your message has been sent successfully. I will get back to you shortly.', 'success');
          form.reset();
        } else {
          // Fallback if running outside of Netlify production
          fallbackToMailto(subjectInput.value, messageInput.value);
        }
      } catch (error) {
        fallbackToMailto(subjectInput.value, messageInput.value);
      } finally {
        setLoading(false);
      }
    });
  }

  function setLoading(loading: boolean) {
    if (!submitBtn || !btnText || !btnSpinner) return;
    if (loading) {
      submitBtn.setAttribute('disabled', 'true');
      btnText.textContent = 'Sending...';
      btnSpinner.classList.remove('hidden');
    } else {
      submitBtn.removeAttribute('disabled');
      btnText.textContent = 'Send Message';
      btnSpinner.classList.add('hidden');
    }
  }

  function showStatus(message: string, type: 'success' | 'error') {
    if (!formStatus) return;
    formStatus.classList.remove('hidden', 'bg-emerald-500/10', 'text-emerald-700', 'dark:text-emerald-300', 'border-emerald-500/20', 'bg-amber-500/10', 'text-amber-700', 'dark:text-amber-300', 'border-amber-500/20');

    if (type === 'success') {
      formStatus.classList.add('bg-emerald-500/10', 'text-emerald-700', 'dark:text-emerald-300', 'border', 'border-emerald-500/20');
      formStatus.textContent = message;
    } else {
      formStatus.classList.add('bg-amber-500/10', 'text-amber-700', 'dark:text-amber-300', 'border', 'border-amber-500/20');
      formStatus.textContent = message;
    }
  }

  function fallbackToMailto(subject: string, message: string) {
    const fallbackSubject = encodeURIComponent(subject || 'Inquiry from Portfolio');
    const fallbackBody = encodeURIComponent(message);
    showStatus('Preparing direct message delivery... Opening your default email client.', 'success');
    window.location.href = `mailto:zulqarnainsaeed2005@gmail.com?subject=${fallbackSubject}&body=${fallbackBody}`;
  }
</script>
