---
// Navigation component with theme toggle, accessible mobile drawer, and smooth anchor tracking
import ThemeToggle from './ThemeToggle.astro';

const navLinks = [
  { href: '#about', label: 'About' },
  { href: '#projects', label: 'Projects' },
  { href: '#skills', label: 'Skills' },
  { href: '#experience', label: 'Timeline' },
  { href: '#certifications', label: 'Milestones' },
  { href: '#coding', label: 'Profiles' },
  { href: '#contact', label: 'Contact' },
];
---

<!-- Skip to Content accessible anchor for screen readers -->
<a
  href="#main-content"
  class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2 focus:bg-accent-600 focus:text-white focus:rounded-lg focus:shadow-xl focus:outline-none"
>
  Skip to content
</a>

<header id="site-header" class="fixed top-0 left-0 right-0 z-40 transition-all duration-300">
  <div class="section-container">
    <nav class="flex items-center justify-between h-16 lg:h-20" aria-label="Main navigation">
      <!-- Monogram Logo / Wordmark -->
      <a
        href="/"
        class="flex items-center gap-2.5 group focus:outline-none"
        aria-label="Zulqarnain Saeed — Homepage"
      >
        <div class="w-9 h-9 rounded-xl bg-teal-700 flex items-center justify-center text-white font-display font-bold text-sm group-hover:bg-accent-500 transition-colors shadow-sm">
          ZS
        </div>
        <div class="flex flex-col">
          <span class="font-display font-bold text-surface-900 dark:text-surface-100 text-sm tracking-tight group-hover:text-accent-600 dark:group-hover:text-accent-400 transition-colors">
            Zulqarnain Saeed
          </span>
          <span class="text-2xs font-mono text-surface-500 hidden sm:block">
            CS Student · UCP
          </span>
        </div>
      </a>

      <!-- Desktop Nav Items -->
      <ul class="hidden lg:flex items-center gap-1 bg-surface-100/60 dark:bg-surface-900/60 p-1.5 rounded-xl border border-surface-200/50 dark:border-surface-800/50 backdrop-blur-md" role="list">
        {navLinks.map(({ href, label }) => (
          <li>
            <a
              href={href}
              data-nav-link
              class="px-3 py-1.5 text-xs font-medium text-surface-600 dark:text-surface-400 hover:text-accent-600 dark:hover:text-accent-400 hover:bg-surface-200/50 dark:hover:bg-surface-800/50 rounded-lg transition-all"
            >
              {label}
            </a>
          </li>
        ))}
      </ul>

      <!-- Right Action Items -->
      <div class="flex items-center gap-2.5">
        <ThemeToggle />

        <a
          href="#contact"
          class="hidden sm:inline-flex btn-primary text-xs py-2 px-3.5 shadow-sm"
        >
          Get in Touch
        </a>

        <!-- Mobile Menu Hamburger Button -->
        <button
          id="mobile-menu-toggle"
          class="lg:hidden p-2 rounded-xl text-surface-600 dark:text-surface-400 hover:bg-surface-100 dark:hover:bg-surface-800 transition-colors cursor-pointer"
          aria-label="Toggle navigation menu"
          aria-expanded="false"
          aria-controls="mobile-menu"
        >
          <svg id="icon-open" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg id="icon-close" class="w-5 h-5 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </nav>
  </div>

  <!-- Mobile Dropdown Navigation -->
  <div
    id="mobile-menu"
    class="lg:hidden hidden border-b border-surface-200 dark:border-surface-800 bg-surface-50/95 dark:bg-surface-950/95 backdrop-blur-xl transition-all shadow-xl"
    role="dialog"
    aria-modal="true"
    aria-label="Mobile navigation menu"
  >
    <div class="section-container py-4 space-y-1">
      <ul class="flex flex-col gap-1" role="list">
        {navLinks.map(({ href, label }) => (
          <li>
            <a
              href={href}
              class="mobile-nav-link flex items-center px-4 py-2.5 text-sm font-medium text-surface-700 dark:text-surface-300 hover:text-accent-600 dark:hover:text-accent-400 hover:bg-surface-100 dark:hover:bg-surface-800/80 rounded-xl transition-all"
            >
              {label}
            </a>
          </li>
        ))}
      </ul>
      <div class="pt-3 border-t border-surface-200 dark:border-surface-800">
        <a href="#contact" class="mobile-nav-link btn-primary w-full justify-center text-xs py-2.5">
          Get in Touch
        </a>
      </div>
    </div>
  </div>
</header>

<script>
  const header = document.getElementById('site-header');
  const toggleBtn = document.getElementById('mobile-menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('icon-open');
  const iconClose = document.getElementById('icon-close');

  function onScroll() {
    if (!header) return;
    if (window.scrollY > 20) {
      header.classList.add('bg-white/85', 'dark:bg-surface-950/85', 'backdrop-blur-xl', 'border-b', 'border-surface-200/60', 'dark:border-surface-800/60', 'shadow-sm');
    } else {
      header.classList.remove('bg-white/85', 'dark:bg-surface-950/85', 'backdrop-blur-xl', 'border-b', 'border-surface-200/60', 'dark:border-surface-800/60', 'shadow-sm');
    }
  }
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  let isMenuOpen = false;
  if (toggleBtn && mobileMenu && iconOpen && iconClose) {
    toggleBtn.addEventListener('click', () => {
      isMenuOpen = !isMenuOpen;
      mobileMenu.classList.toggle('hidden', !isMenuOpen);
      toggleBtn.setAttribute('aria-expanded', String(isMenuOpen));
      iconOpen.classList.toggle('hidden', isMenuOpen);
      iconClose.classList.toggle('hidden', !isMenuOpen);
    });

    document.querySelectorAll('.mobile-nav-link').forEach(link => {
      link.addEventListener('click', () => {
        isMenuOpen = false;
        mobileMenu.classList.add('hidden');
        toggleBtn.setAttribute('aria-expanded', 'false');
        iconOpen.classList.remove('hidden');
        iconClose.classList.add('hidden');
      });
    });
  }
</script>
