---
// Experience & Education Timeline section
import { timeline } from '../data/profile';
---

<section
  id="experience"
  class="section-padding relative overflow-hidden bg-white dark:bg-surface-900"
  aria-label="Education and Experience Timeline"
>
  <div class="absolute inset-0 dot-pattern opacity-30 dark:opacity-15" aria-hidden="true"></div>

  <div class="section-container relative z-10">
    <div class="text-center max-w-2xl mx-auto mb-16">
      <div class="section-label justify-center" data-reveal>Track Record</div>
      <h2 class="font-display text-4xl sm:text-5xl font-bold text-surface-900 dark:text-surface-50 mb-4 tracking-tight" data-reveal data-delay="100">
        Education &amp; Experience
      </h2>
      <p class="text-surface-600 dark:text-surface-400 text-lg leading-relaxed" data-reveal data-delay="200">
        Bridging rigorous academic study with real venture building, client delivery, and practical engineering.
      </p>
    </div>

    <!-- Vertical Timeline -->
    <div class="max-w-3xl mx-auto">
      <div class="relative">
        <!-- Connecting Line -->
        <div class="absolute left-6 sm:left-8 top-4 bottom-8 w-px bg-gradient-to-b from-accent-500/40 via-surface-300 dark:via-surface-700 to-transparent" aria-hidden="true"></div>

        <div class="space-y-10">
          {timeline.map((item, i) => (
            <div
              class="relative flex gap-6 sm:gap-8 items-start group"
              data-reveal
              data-delay={String(i * 120 + 200)}
            >
              <!-- Timeline Marker -->
              <div class="relative shrink-0 mt-1">
                <div class="w-12 h-12 sm:w-16 sm:h-16 rounded-2xl flex items-center justify-center bg-surface-50 dark:bg-surface-800 border-2 border-surface-200 dark:border-surface-700 shadow-sm z-10 relative group-hover:border-accent-500 transition-colors">
                  {item.icon === 'graduation' && (
                    <svg class="w-6 h-6 text-accent-600 dark:text-accent-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
                      <path d="M12 14l9-5-9-5-9 5 9 5z" />
                      <path d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z" />
                      <path stroke-linecap="round" stroke-linejoin="round" d="M12 14l9-5-9-5-9 5 9 5zm0 0l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14zm-4 6v-7.5l4-2.222" />
                    </svg>
                  )}
                  {item.icon === 'briefcase' && (
                    <svg class="w-6 h-6 text-amber-600 dark:text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
                      <rect x="2" y="7" width="20" height="14" rx="2" ry="2" />
                      <path stroke-linecap="round" stroke-linejoin="round" d="M16 21V5a2 2 0 00-2-2h-4a2 2 0 00-2 2v16" />
                    </svg>
                  )}
                  {item.icon === 'code' && (
                    <svg class="w-6 h-6 text-teal-600 dark:text-teal-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
                    </svg>
                  )}
                </div>
                {item.current && (
                  <div class="absolute -top-1 -right-1 w-3.5 h-3.5 rounded-full bg-emerald-500 border-2 border-white dark:border-surface-900 animate-pulse-slow z-20" title="Active"></div>
                )}
              </div>

              <!-- Card Body -->
              <div class="card p-6 flex-1 hover:border-accent-500/40 transition-colors">
                <div class="flex flex-wrap items-start justify-between gap-2 mb-3">
                  <div>
                    <h3 class="font-display font-bold text-surface-900 dark:text-surface-50 text-lg leading-snug">
                      {item.title}
                    </h3>
                    <div class="flex items-center gap-2 mt-1 flex-wrap">
                      {'link' in item && item.link ? (
                        <a
                          href={item.link}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="text-sm font-semibold text-accent-600 dark:text-accent-400 hover:underline inline-flex items-center gap-1"
                        >
                          {item.organization}
                          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                          </svg>
                        </a>
                      ) : (
                        <span class="text-sm font-semibold text-surface-800 dark:text-surface-200">{item.organization}</span>
                      )}
                      <span class="text-surface-300 dark:text-surface-600">·</span>
                      <span class="text-xs font-mono text-surface-500">{item.location}</span>
                    </div>
                  </div>

                  <div class="flex items-center gap-2">
                    {item.current && (
                      <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-emerald-700 dark:text-emerald-300 text-xs font-mono font-medium">
                        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse-slow"></span>
                        Current
                      </span>
                    )}
                    <span class="text-xs font-mono text-surface-400 whitespace-nowrap">{item.period}</span>
                  </div>
                </div>

                <p class="text-sm text-surface-600 dark:text-surface-400 leading-relaxed mb-4">
                  {item.description}
                </p>

                <!-- Category Badge -->
                <div class="pt-3 border-t border-surface-100 dark:border-surface-800 flex items-center justify-between">
                  <span class={`text-2xs font-mono font-medium px-2 py-0.5 rounded ${
                    item.type === 'education' ? 'bg-blue-500/10 text-blue-700 dark:text-blue-300 border border-blue-500/20' :
                    item.type === 'venture'   ? 'bg-amber-500/10 text-amber-700 dark:text-amber-300 border border-amber-500/20' :
                    'bg-teal-500/10 text-teal-700 dark:text-teal-300 border border-teal-500/20'
                  }`}>
                    {item.type === 'education' ? '🎓 Academic Program' : item.type === 'venture' ? '🚀 Startup Venture' : '💻 Client Practice'}
                  </span>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
