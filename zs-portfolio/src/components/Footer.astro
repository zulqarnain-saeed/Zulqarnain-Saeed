---
// Footer component
---

<footer class="bg-surface-950 text-surface-400 py-12 border-t border-surface-900" role="contentinfo">
  <div class="section-container">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-8 pb-10 border-b border-surface-900">

      <!-- Column 1 (5 cols): Identity -->
      <div class="md:col-span-5 space-y-3">
        <div class="flex items-center gap-2.5">
          <div class="w-8 h-8 rounded-xl bg-teal-600 flex items-center justify-center text-white font-display font-bold text-xs">
            ZS
          </div>
          <span class="font-display font-bold text-white text-base tracking-tight">
            Zulqarnain Saeed
          </span>
        </div>
        <p class="text-xs text-surface-400 leading-relaxed max-w-sm">
          Computer Science undergraduate at the University of Central Punjab, Lahore. Building software systems, engineering web products with Zentorix, and exploring DevOps.
        </p>
        <p class="text-xs font-mono text-surface-500">
          Lahore, Pakistan · Open to Software &amp; IT Internships
        </p>
      </div>

      <!-- Column 2 (4 cols): Quick Navigation -->
      <div class="md:col-span-4 space-y-2">
        <div class="font-mono text-2xs uppercase tracking-wider text-surface-400 font-semibold mb-3">
          Navigation
        </div>
        <nav class="grid grid-cols-2 gap-2 text-xs" aria-label="Footer Quick Links">
          <a href="#about" class="hover:text-teal-400 transition-colors">About Me</a>
          <a href="#projects" class="hover:text-teal-400 transition-colors">Projects &amp; Systems</a>
          <a href="#skills" class="hover:text-teal-400 transition-colors">Skills &amp; Toolkit</a>
          <a href="#experience" class="hover:text-teal-400 transition-colors">Career Timeline</a>
          <a href="#certifications" class="hover:text-teal-400 transition-colors">Milestones</a>
          <a href="#coding" class="hover:text-teal-400 transition-colors">Coding Profiles</a>
          <a href="#contact" class="hover:text-teal-400 transition-colors">Get in Touch</a>
        </nav>
      </div>

      <!-- Column 3 (3 cols): Official Profile Links -->
      <div class="md:col-span-3 space-y-2">
        <div class="font-mono text-2xs uppercase tracking-wider text-surface-400 font-semibold mb-3">
          Profiles
        </div>
        <div class="flex flex-col gap-2 text-xs">
          <a
            href="https://github.com/zulqarnain-saeed"
            target="_blank"
            rel="noopener noreferrer"
            class="hover:text-teal-400 transition-colors inline-flex items-center gap-1.5"
          >
            <span>GitHub Profile</span>
            <span class="text-surface-600">↗</span>
          </a>
          <a
            href="https://www.linkedin.com/in/zulqarnain-saeed/"
            target="_blank"
            rel="noopener noreferrer"
            class="hover:text-teal-400 transition-colors inline-flex items-center gap-1.5"
          >
            <span>LinkedIn Network</span>
            <span class="text-surface-600">↗</span>
          </a>
          <a
            href="https://leetcode.com/u/zulqarnain-saeed/"
            target="_blank"
            rel="noopener noreferrer"
            class="hover:text-teal-400 transition-colors inline-flex items-center gap-1.5"
          >
            <span>LeetCode Submissions</span>
            <span class="text-surface-600">↗</span>
          </a>
          <a
            href="https://www.hackerrank.com/profile/zulqarnain_saeed"
            target="_blank"
            rel="noopener noreferrer"
            class="hover:text-teal-400 transition-colors inline-flex items-center gap-1.5"
          >
            <span>HackerRank Challenges</span>
            <span class="text-surface-600">↗</span>
          </a>
          <a
            href="https://zentorix.netlify.app/"
            target="_blank"
            rel="noopener noreferrer"
            class="text-teal-400 hover:text-teal-300 transition-colors inline-flex items-center gap-1.5 font-medium"
          >
            <span>Zentorix Venture</span>
            <span class="text-teal-500">↗</span>
          </a>
        </div>
      </div>

    </div>

    <!-- Bottom Colophon -->
    <div class="flex flex-col sm:flex-row items-center justify-between gap-4 pt-8 text-2xs font-mono text-surface-500">
      <div>
        © {new Date().getFullYear()} Zulqarnain Saeed. All rights reserved.
      </div>
      <div class="flex items-center gap-4">
        <span>Static Astro Architecture</span>
        <span>·</span>
        <span>Tailwind CSS</span>
        <span>·</span>
        <a href="https://zulqarnain-saeed.netlify.app" class="hover:text-surface-300 transition-colors">
          Hosted on Netlify
        </a>
      </div>
    </div>
  </div>
</footer>
